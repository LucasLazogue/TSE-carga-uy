<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>tse.cargauy</groupId>
  <artifactId>nodo-tracking</artifactId>
  <version>1.0-SNAPSHOT</version>
  <name>nodo-tracking</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>24</maven.compiler.release>
  </properties>

  <!-- la misma version de OpenTelemetry que trae WildFly 41 en el componente central -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.opentelemetry</groupId>
        <artifactId>opentelemetry-bom</artifactId>
        <version>1.48.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- cliente JMS de Artemis: publica directo en el broker del componente central -->
    <dependency>
      <groupId>org.apache.artemis</groupId>
      <artifactId>artemis-jakarta-client</artifactId>
      <version>2.57.0</version>
    </dependency>
    <!-- observabilidad: trazas, metricas y logs por OTLP, configurados con las variables OTEL_* estandar -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-extension-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-testing</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- la misma API JSON que usa el MDB del central, para que los dos lados parseen igual -->
    <dependency>
      <groupId>jakarta.json</groupId>
      <artifactId>jakarta.json-api</artifactId>
      <version>2.1.3</version>
    </dependency>
    <!-- implementacion de la API: solo hace falta al ejecutar -->
    <dependency>
      <groupId>org.eclipse.parsson</groupId>
      <artifactId>parsson</artifactId>
      <version>1.1.7</version>
      <scope>runtime</scope>
    </dependency>
    <!-- un broker Artemis embebido para probar el publicador sin el central -->
    <dependency>
      <groupId>org.apache.activemq</groupId>
      <artifactId>artemis-server</artifactId>
      <version>2.57.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>nodo-tracking</finalName>
    <plugins>
      <!-- 3.x corre los tests de JUnit 5 en mvn verify -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!-- la configuracion del nodo sale del entorno: ConfigTest lee estos valores -->
          <environmentVariables>
            <NODO_ID>nodo-prueba</NODO_ID>
            <NODO_JMS_USUARIO>usuario-prueba</NODO_JMS_USUARIO>
            <NODO_JMS_CLAVE>clave-prueba</NODO_JMS_CLAVE>
            <NODO_PUERTO>9091</NODO_PUERTO>
            <NODO_VEHICULOS_EXTRA>3</NODO_VEHICULOS_EXTRA>
            <NODO_ACELERAR>2.5</NODO_ACELERAR>
            <NODO_SIN_COBERTURA>10, 5</NODO_SIN_COBERTURA>
            <NODO_PRUEBA_NUMERO_INVALIDO>diez</NODO_PRUEBA_NUMERO_INVALIDO>
          </environmentVariables>
        </configuration>
      </plugin>
      <!-- cobertura de las pruebas (AC25), en target/site/jacoco. NodoTracking solo arma las piezas y arranca los hilos -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
        <executions>
          <execution>
            <id>preparar-agente</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>reporte-cobertura</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
            <configuration>
              <excludes>
                <exclude>tse/cargauy/nodotracking/NodoTracking*</exclude>
              </excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>copiar-dependencias</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>tse.cargauy.nodotracking.NodoTracking</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <!-- en el CI (mvn verify -Pci) el build falla si la cobertura de lineas baja del 80% (AC25). Solo en el CI: en una
       maquina sin Docker las pruebas contra la base se saltean y la cobertura local no es la real -->
  <profiles>
    <profile>
      <id>ci</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>0.8.15</version>
            <executions>
              <execution>
                <id>umbral-cobertura</id>
                <phase>verify</phase>
                <goals>
                  <goal>check</goal>
                </goals>
                <configuration>
                  <excludes>
                    <exclude>tse/cargauy/nodotracking/NodoTracking*</exclude>
                  </excludes>
                  <rules>
                    <rule>
                      <element>BUNDLE</element>
                      <limits>
                        <limit>
                          <counter>LINE</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.80</minimum>
                        </limit>
                      </limits>
                    </rule>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
