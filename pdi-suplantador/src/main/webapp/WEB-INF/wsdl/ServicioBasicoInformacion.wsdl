<?xml version="1.0" encoding="UTF-8"?>
<!--
  Contrato del suplantador del Servicio Basico de Informacion de DNIC, armado desde la descripcion funcional
  publicada por AGESIC (v1.0, 29/06/2012). Operaciones, campos y codigos son los del documento. El WSDL real no es
  publico: el namespace, los soapAction y la direccion son de este suplantador.
-->
<wsdl:definitions name="ServicioBasicoInformacion"
                  targetNamespace="urn:carga-uy:suplantador-pdi:dnic:servicio-basico-informacion"
                  xmlns:tns="urn:carga-uy:suplantador-pdi:dnic:servicio-basico-informacion"
                  xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <wsdl:types>
    <xs:schema targetNamespace="urn:carga-uy:suplantador-pdi:dnic:servicio-basico-informacion"
               elementFormDefault="qualified">

      <xs:element name="paramobtPersonaPorDoc" type="tns:ParamObtPersonaPorDoc"/>
      <xs:element name="resultObtPersonaPorDoc" type="tns:ResultObtPersonaPorDoc"/>
      <xs:element name="paramProductDesc" type="tns:ParamProductDesc"/>
      <xs:element name="resultObtProductDesc" type="tns:ResultObtProductDesc"/>

      <xs:complexType name="ParamObtPersonaPorDoc">
        <xs:sequence>
          <xs:element name="organizacion" type="xs:string"/>
          <xs:element name="passwordEntidad" type="xs:string"/>
          <xs:element name="NroDocumento" type="xs:string"/>
          <xs:element name="TipoDocumento" type="xs:string" default="DO"/>
        </xs:sequence>
      </xs:complexType>

      <xs:complexType name="ResultObtPersonaPorDoc">
        <xs:sequence>
          <xs:element name="objPersona" type="tns:ObjPersona" minOccurs="0"/>
          <xs:element name="Warnings" type="tns:ListaMensajes" minOccurs="0"/>
          <xs:element name="Errores" type="tns:ListaMensajes" minOccurs="0"/>
        </xs:sequence>
      </xs:complexType>

      <xs:complexType name="ObjPersona">
        <xs:sequence>
          <xs:element name="codTipoDocumento" type="xs:string" minOccurs="0"/>
          <xs:element name="nroDocumento" type="xs:string" minOccurs="0"/>
          <xs:element name="nombre1" type="xs:string" minOccurs="0"/>
          <xs:element name="nombre2" type="xs:string" minOccurs="0"/>
          <xs:element name="Apellido1" type="xs:string" minOccurs="0"/>
          <xs:element name="Apellido2" type="xs:string" minOccurs="0"/>
          <xs:element name="ApellidoAdoptivo1" type="xs:string" minOccurs="0"/>
          <xs:element name="ApellidoAdoptivo2" type="xs:string" minOccurs="0"/>
          <!-- 1 masculino, 2 femenino -->
          <xs:element name="sexo" type="xs:int" minOccurs="0"/>
          <!-- "yyyy-mmdd"; puede venir vacia o solo con anio-mes o anio -->
          <xs:element name="fechaNacimiento" type="xs:string" minOccurs="0"/>
          <!-- 1 oriental, 3 extranjero, 0 desconocida -->
          <xs:element name="codNacionalidad" type="xs:int" minOccurs="0"/>
          <xs:element name="nombreEnCedula" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:complexType>

      <xs:complexType name="ListaMensajes">
        <xs:sequence>
          <xs:element name="Mensajes" type="tns:Mensaje" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
      </xs:complexType>

      <xs:complexType name="Mensaje">
        <xs:sequence>
          <xs:element name="CodMensaje" type="xs:int"/>
          <xs:element name="Descripcion" type="xs:string" minOccurs="0"/>
          <xs:element name="DatoExtra" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:complexType>

      <!-- la operacion no tiene parametros de entrada -->
      <xs:complexType name="ParamProductDesc">
        <xs:sequence/>
      </xs:complexType>

      <xs:complexType name="ResultObtProductDesc">
        <xs:sequence>
          <xs:element name="obtProductInfo" type="tns:ObtProductInfo"/>
        </xs:sequence>
      </xs:complexType>

      <xs:complexType name="ObtProductInfo">
        <xs:sequence>
          <xs:element name="version" type="xs:string"/>
          <xs:element name="modalidad" type="xs:string"/>
          <xs:element name="descripcion" type="xs:string"/>
        </xs:sequence>
      </xs:complexType>
    </xs:schema>
  </wsdl:types>

  <wsdl:message name="ObtPersonaPorDocEntrada">
    <wsdl:part name="parametros" element="tns:paramobtPersonaPorDoc"/>
  </wsdl:message>
  <wsdl:message name="ObtPersonaPorDocSalida">
    <wsdl:part name="resultado" element="tns:resultObtPersonaPorDoc"/>
  </wsdl:message>
  <wsdl:message name="ProductDescEntrada">
    <wsdl:part name="parametros" element="tns:paramProductDesc"/>
  </wsdl:message>
  <wsdl:message name="ProductDescSalida">
    <wsdl:part name="resultado" element="tns:resultObtProductDesc"/>
  </wsdl:message>

  <wsdl:portType name="ServicioBasicoInformacionPortType">
    <wsdl:operation name="ObtPersonaPorDoc">
      <wsdl:input message="tns:ObtPersonaPorDocEntrada"/>
      <wsdl:output message="tns:ObtPersonaPorDocSalida"/>
    </wsdl:operation>
    <wsdl:operation name="ProductDesc">
      <wsdl:input message="tns:ProductDescEntrada"/>
      <wsdl:output message="tns:ProductDescSalida"/>
    </wsdl:operation>
  </wsdl:portType>

  <wsdl:binding name="ServicioBasicoInformacionBinding" type="tns:ServicioBasicoInformacionPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="ObtPersonaPorDoc">
      <soap:operation soapAction="urn:carga-uy:suplantador-pdi:dnic:servicio-basico-informacion/ObtPersonaPorDoc"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="ProductDesc">
      <soap:operation soapAction="urn:carga-uy:suplantador-pdi:dnic:servicio-basico-informacion/ProductDesc"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
  </wsdl:binding>

  <wsdl:service name="ServicioBasicoInformacion">
    <wsdl:port name="ServicioBasicoInformacionPort" binding="tns:ServicioBasicoInformacionBinding">
      <soap:address location="http://localhost:8085/pdi-suplantador/ServicioBasicoInformacion"/>
    </wsdl:port>
  </wsdl:service>
</wsdl:definitions>
