    {
      "type": "timeseries",
      "title": "Corte abierto por integración",
      "id": 19,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "1 mientras el corte (circuit breaker) está abierto y las llamadas responden \"no disponible\" sin salir; 0,5 medio abierto, probando de nuevo (AC13).",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "auto"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (integracion) (label_replace(ft_circuitbreaker_state_current{state=\"open\"}, \"integracion\", \"$1\", \"method\", \".*\\\\.([A-Za-z]+)Client\\\\..*\")) + 0.5 * max by (integracion) (label_replace(ft_circuitbreaker_state_current{state=\"halfOpen\"}, \"integracion\", \"$1\", \"method\", \".*\\\\.([A-Za-z]+)Client\\\\..*\"))",
          "legendFormat": "{{integracion}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
