<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="carga-uy" transaction-type="JTA">

        <jta-data-source>java:jboss/datasources/CargaUyDS</jta-data-source>

        <properties>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="jakarta.persistence.schema-generation.database.action" value="update"/>
            <!-- las relaciones EAGER de una pagina de resultados se cargan de a lotes (id = ANY(...)) y no con una
                 consulta por fila: el listado de viajes de una empresa pasaba de 38 consultas a 9 -->
            <property name="hibernate.default_batch_fetch_size" value="32"/>
        </properties>

    </persistence-unit>

</persistence>
