GUBUY_CLIENT_ID=
GUBUY_CLIENT_SECRET=
# Usarla en ambientes ed prueba local, gubuy no admite redirect a localhost/callback
# por eso en el wildfly se agrega un proxy para que redirija a localhost:8080/callback
GUBUY_REDIRECT_URI=http://localhost:8080
GUBUY_MOCK=false
# TODO mock: borrar GUBUY_MOCK

CARGAUY_JWT_SECRET=
# url publica de la api, por ejemplo https://<central>/carga-uy/api. prueba de posesión (DPoP) de la app la firma;
# vacia, se usa la del pedido (alcanza sin proxy delante)
CARGAUY_API_URL=

LDAP_ADMIN_USUARIO=
LDAP_ADMIN_PASSWORD=

CARGAUY_ZONA_HORARIA=America/Montevideo
