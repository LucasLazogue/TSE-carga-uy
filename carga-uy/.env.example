# Todas las variables son opcionales: sin definir, el Compose usa sus valores de desarrollo (login simulado,
# administrador admin-local / admin-local-123 y los nodos registrados). Ver el README principal

# gub.uy de testing (docs/seguridad.md): descomentar GUBUY_MOCK y GUBUY_REDIRECT_URI
GUBUY_CLIENT_ID=
GUBUY_CLIENT_SECRET=
# Usarla en ambientes ed prueba local, gubuy no admite redirect a localhost/callback
# por eso en el wildfly se agrega un proxy para que redirija a localhost:8080/callback
# GUBUY_REDIRECT_URI=http://localhost:8080
# GUBUY_MOCK=false
# TODO mock: borrar GUBUY_MOCK

CARGAUY_JWT_SECRET=
# clave del estado de las pantallas del backoffice (AES de 32 bytes en base64): se genera con openssl rand -base64 32.
# tiene que ser la misma en todas las instancias del central; vacia, cada una usa una propia (anda con una sola)
CARGAUY_CLAVE_VISTAS=
# url publica de la api, por ejemplo https://<central>/carga-uy/api. prueba de posesión (DPoP) de la app la firma;
# vacia, se usa la del pedido (alcanza sin proxy delante)
CARGAUY_API_URL=
CARGAUY_NODOS_HTTPS=false

LDAP_ADMIN_USUARIO=
LDAP_ADMIN_PASSWORD=

# central: con que se presenta ante la PDI. sin definir, el Compose usa carga-uy y clave-pdi-desarrollo
PDI_ORGANIZACION=
PDI_PASSWORD_ENTIDAD=
# suplantador de la PDI: credenciales que acepta, tienen que coincidir con las del central. mismos valores por defecto
SUPLANTADOR_ORGANIZACION=
SUPLANTADOR_PASSWORD_ENTIDAD=
# para probar la resiliencia: SUPLANTADOR_DEMORA_MS=10000 (tarda en responder) o SUPLANTADOR_FALLA=true (error 1001 a todo)
SUPLANTADOR_DEMORA_MS=0
SUPLANTADOR_FALLA=false

CARGAUY_ZONA_HORARIA=America/Montevideo

# datos que carga el central al arrancar: demo (por defecto) o base (solo roles, rubros, tipos de carga y normas)
CARGAUY_DATOS=demo

# elenco de la demo (ver "Datos del central" en docs/infraestructura.md). Vacio: solo los datos de prueba y,
# sin DEMO_NODOS, los cuatro nodos del Compose
# DEMO_FUNCIONARIOS=
# DEMO_RESPONSABLES=
# DEMO_CHOFERES=
# DEMO_CIUDADANOS=
# DEMO_NODOS=tracking-1;tracking-2;balanzas-sur|http://balanzas-sur:8080/nodo-balanzas|CLAVE_CENTRAL
